# CENTRAL SERVER ONLY. Never copy this file, a bot token, OAuth client secret, or a
# backend credential to a Remote client PC. Keep the real .env untracked and private.
DISCORD_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
# Optional: sync commands immediately to one development guild. This is not an
# authorization or identity setting; interaction.user.id remains authoritative.
# DISCORD_GUILD_ID=123456789012345678
DISCORD_GUILD_ID=

# Discord OAuth2 authorization-code onboarding. The client ID is public application
# metadata, but the client secret must remain central-server-only. Configure the exact
# redirect URI in the Discord Developer Portal as:
#   https://YOUR_REMOTE_HOST/remote/v1/onboarding/discord/callback
# Leave BOTH blank to disable browser onboarding and keep temporary /macro pair only.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Central Remote backend. Keep the default loopback bind when a TLS reverse proxy or
# secure development tunnel runs on this PC.
ULTIMATE_REMOTE_BIND_HOST=127.0.0.1
ULTIMATE_REMOTE_BIND_PORT=8765
ULTIMATE_REMOTE_DATABASE_PATH=runtime/central/remote.db

# Stable public HTTPS origin for production onboarding, Agent WSS, and development
# pairing. It must have normally trusted TLS and preserve Authorization for POST and
# WebSocket Upgrade requests. Quick Tunnel URLs are development-only because they
# change whenever the tunnel restarts.
ULTIMATE_REMOTE_PUBLIC_HTTPS_ORIGIN=

# One-time browser onboarding. No Discord user ID is accepted from the client; the
# owner comes only from the Discord OAuth `identify` authorization.
ULTIMATE_REMOTE_ONBOARDING_TTL_SECONDS=600
ULTIMATE_REMOTE_ONBOARDING_SOURCE_LIMIT=20
ULTIMATE_REMOTE_ONBOARDING_GLOBAL_LIMIT=200
ULTIMATE_REMOTE_ONBOARDING_WINDOW_SECONDS=600

# Temporary development pairing fallback: 256-bit, hashed, single-use tickets.
ULTIMATE_REMOTE_PAIRING_TTL_SECONDS=600
ULTIMATE_REMOTE_PAIRING_ISSUE_LIMIT=5
ULTIMATE_REMOTE_PAIRING_ISSUE_WINDOW_SECONDS=3600
ULTIMATE_REMOTE_PAIRING_SOURCE_LIMIT=10
ULTIMATE_REMOTE_PAIRING_GLOBAL_LIMIT=100
ULTIMATE_REMOTE_PAIRING_WINDOW_SECONDS=600

# For direct TLS, configure both paths. Never commit the key.
# ULTIMATE_REMOTE_TLS_CERT_FILE=C:\path\to\certificate.pem
# ULTIMATE_REMOTE_TLS_KEY_FILE=C:\path\to\private-key.pem
